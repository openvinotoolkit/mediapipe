package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.BUILD", "*.diff"]))

alias(
    name = "openvino",
    actual = select({
        "@mediapipe//mediapipe:windows": "@windows_openvino//:openvino",
        "//conditions:default": "@openvino//:openvino",
    }),
)

# Enabled with --config=gst (--define=OPENVINO_GSTREAMER=1).
config_setting(
    name = "gstreamer_enabled",
    define_values = {"OPENVINO_GSTREAMER": "1"},
)

config_setting(
    name = "gstreamer_enabled_windows",
    constraint_values = ["@platforms//os:windows"],
    define_values = {"OPENVINO_GSTREAMER": "1"},
)

alias(
    name = "gstreamer",
    actual = select({
        "@mediapipe//mediapipe:windows": "@windows_gstreamer//:gstreamer",
        "//conditions:default": "@linux_gstreamer//:gstreamer",
    }),
)

filegroup(
    name = "windows_openvino_runtime_dlls",
    srcs = select({
        "@mediapipe//mediapipe:windows": ["@windows_openvino//:runtime_dlls"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "windows_runtime_dlls",
    srcs = select({
        "@mediapipe//mediapipe:windows": [
            "@windows_opencv//:runtime_dlls",
            "@windows_openvino//:runtime_dlls",
        ],
        "//conditions:default": [],
    }),
)
# MediaPipe graph that runs image classification with OpenVINO.
#
# The session node compiles the model once and publishes a pool of inference
# requests as the "session" side packet. Any number of graphs (or nodes) using
# the same model_path/device/plugin_config share that pool.

output_stream: "output_tensors"

node {
  calculator: "OpenVINOSessionCalculator"
  output_side_packet: "SESSION:session"
  node_options: {
    [type.googleapis.com/mediapipe.OpenVINOSessionCalculatorOptions] {
      model_path: "/models/resnet50/resnet50.xml"
      device: "GPU"
      va_device_path: "/dev/dri/renderD128"
      # Accept decoder-native dimensions, then resize in GPU preprocessing.
      layout: "NHWC:NCHW"
      color_format: "NV12_2:BGR"
      precision: "uint8:fp32"
      num_infer_requests: 1
    }
  }
}

node {
  calculator: "GStreamerRemoteTensorCalculator"
  input_side_packet: "SESSION:session"
  output_stream: "REMOTE_FRAME:video_frame"
  node_options: {
    [type.googleapis.com/mediapipe.GStreamerRemoteTensorCalculatorOptions] {
      source: "/path/to/video.mp4"
      max_frames: 0
    }
  }
}

node {
  calculator: "OpenVINOInferenceCalculator"
  input_side_packet: "SESSION:session"
  input_stream: "REMOTE_FRAME:video_frame"
  output_stream: "TENSORS:output_tensors"
}
